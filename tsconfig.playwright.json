{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "resolveJsonModule": true,
    "strict": true,
    "types": [
      "node"
    ],
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.cache/typescript/playwright.tsbuildinfo"
  },
  "include": [
    "playwright.config.ts",
    "playwright.cloudflare-check.config.ts",
    "e2e/**/*.ts"
  ]
}
